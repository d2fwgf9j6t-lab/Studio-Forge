{
  "expo": {
    "name": "Northline Studio",
    "slug": "mobile-daw",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon-purple.png",
    "scheme": "mobile-daw",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon-purple.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Northline Studio to record vocal takes.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
